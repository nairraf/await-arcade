{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@await-arcade/contract": ["packages/contract/src/index.ts"],
      "@await-arcade/framework": ["packages/framework/src/index.ts"],
      "@await-arcade/shell": ["packages/shell/src/index.ts"],
      "@await-arcade/shell/registry": ["packages/shell/src/registry.generated.ts"],
      "@await-arcade/server": ["packages/server/src/index.ts"],
      "@await-arcade/game-*": ["games/*/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "games/**/*.ts",
    "games/**/*.tsx",
    "tools/**/*.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "vite.aliases.ts"
  ],
  "exclude": ["**/dist", "**/node_modules", "packages/host-opencode"]
}
